    "./inventory": "./src/core/inventory.js",
    "./elytra": "./src/core/elytra.js",
    "./rockets": "./src/core/rockets.js",
    "./spatial": "./src/flight/spatial.js",
    "./phases": "./src/flight/phases.js",
    "./wander": "./src/flight/wander.js",
    "./landing": "./src/flight/landing.js"
  },
  "scripts": {
